<script>
const $=s=>document.querySelector(s);
const t=(hi,en)=>state.lang==='hi'?hi:en;
let state={lang:'hi',teams:[],name:'Akku',sport:'cricket'};
try{const saved=JSON.parse(localStorage.getItem('akku-play-v2'));if(saved){state.lang=saved.lang==='en'?'en':'hi';state.name=typeof saved.name==='string'?saved.name.slice(0,30):'Akku';state.teams=Array.isArray(saved.teams)?saved.teams.filter(x=>x&&typeof x.match==='string'&&Array.isArray(x.players)&&x.players.every(p=>p&&typeof p.name==='string')):[]}}catch(e){}
let page='home',draft=null,toastTimer;
const fixtures={
cricket:[{a:'Lucknow Lions',b:'Mumbai Mavericks',ac:'LKL',bc:'MMV'},{a:'Delhi Falcons',b:'Chennai Chargers',ac:'DLF',bc:'CHC'}],
