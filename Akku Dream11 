};
const names=['A. Sharma','R. Singh','V. Mehta','S. Khan','D. Patel','K. Verma','N. Yadav','M. Roy','P. Kumar','T. Ali'];
const roles={cricket:['BAT','BAT','WK','AR','AR','BOWL','BOWL','BAT','BOWL','WK'],football:['FWD','MID','GK','DEF','MID','DEF','FWD','DEF','MID','GK'],kabaddi:['RAIDER','DEF','AR','RAIDER','DEF','AR','RAIDER','DEF','AR','DEF']};
