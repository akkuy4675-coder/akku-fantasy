const art=`<div class="art" aria-hidden="true"><div class="stamp">100% FREE<br>100% SPORT</div><svg viewBox="0 0 360 300" fill="none"><ellipse cx="185" cy="272" rx="122" ry="16" fill="#103b2d"/><path d="M50 220L210 113L325 187L164 290Z" fill="#527b4e"/><path d="M66 221L211 126L309 188L165 276Z" stroke="#d4e4b9" stroke-opacity=".5"/><path d="M164 276L211 126M116 190L265 225" stroke="#b7cb9c" stroke-opacity=".35"/><path d="M153 228L210 190L242 210L185 248Z" fill="#c9bd84"/><g transform="rotate(28 180 145)"><rect x="171" y="50" width="16" height="80" rx="6" fill="#e9e4cc"/><rect x="167" y="50" width="24" height="45" rx="4" fill="#ec8153"/><path d="M163 117Q179 109 196 117L204 211Q180 228 157 211Z" fill="#ecd094"/><path d="M176 129L175 205" stroke="#fff0c9" stroke-width="7"/><path d="M160 179H202V196H158Z" fill="#174c3c"/><text x="173" y="192" fill="#d4ed82" font-size="13" font-family="sans-serif" font-weight="bold">A</text></g><circle cx="273" cy="160" r="22" fill="#ec8153"/><path d="M265 141Q282 160 265 180M272 139Q291 160 272 183" stroke="#ffe2c8" stroke-width="2" stroke-dasharray="3 3"/><path d="M70 101L96 91M71 120L89 119M84 77L94 85" stroke="#d4ed82" stroke-width="3" stroke-linecap="round"/><circle cx="278" cy="66" r="3" fill="#d4ed82"/></svg><span class="art-caption">YOUR INSTINCTS. YOUR TEAM.</span></div>`;
function matchHTML(m,i){return `<article class="match"><div class="match-top"><span>Practice ${state.sport[0].toUpperCase()+state.sport.slice(1)} League</span><span class="badge">DEMO · FREE</span></div><div class="teams"><div class="team"><div class="shield">${m.ac}</div><div><b>${m.ac}</b><small>${m.a}</small></div></div><span class="vs">VS</span><div class="team"><div><b>${m.bc}</b><small>${m.b}</small></div><div class="shield blue">${m.bc}</div></div></div><div class="match-bottom"><span>✦ ${t('शून्य प्रवेश शुल्क','Zero entry fee')}</span><button class="outline" data-build="${i}">${t('टीम बनाएँ','Create team')} ↗</button></div></article>`}
function steps(){return `<div class="steps"><div class="step"><span class="number">01 /</span><b>${t('5 खिलाड़ी चुनें','Pick 5 players')}</b><p>${t('यह आसान डेमो फ़ॉर्मेट है।','A simplified practice format.')}</p></div><div class="step"><span class="number">02 /</span><b>${t('कप्तान तय करें','Choose your leaders')}</b><p>${t('कप्तान और उपकप्तान अलग चुनें।','Pick a captain and vice-captain.')}</p></div><div class="step"><span class="number">03 /</span><b>${t('मुफ़्त खेलें','Play for free')}</b><p>${t('टीम सेव करें, डेमो स्कोर आज़माएँ।','Save your team. Simulate a score.')}</p></div></div>`}
function render(){
let html='';
if(page==='home'){
html=`<div class="intro"><div><div class="eyebrow">THE FAN'S PLAYGROUND</div><h1>${t('खेल आपका। टीम आपकी।','Big game. Bigger instincts.')}</h1></div><span class="status">● FREE-TO-PLAY DEMO</span></div><section class="hero"><div class="hero-copy"><div class="eyebrow">FANTASY, WITHOUT THE FEES</div><h2>BUILD YOUR TEAM.<br><span>OWN THE GAME.</span></h2><p>${t('पसंदीदा खिलाड़ी चुनें। अपनी खेल समझ आज़माएँ। जीतें पॉइंट्स, पैसे नहीं।','Pick your favourites. Put your sporting instincts to work. Play for points, not money.')}</p><button class="primary" data-build="0">${t('अपनी पहली टीम बनाएँ','Build your first team')} &nbsp; ↗</button></div>${art}</section><div class="strip"><span><b>03</b>${t('खेल','Sports')}</span><span><b>₹0</b>${t('प्रवेश शुल्क','Entry fee')}</span><span><b>${state.teams.length.toString().padStart(2,'0')}</b>${t('सेव टीमें','Saved teams')}</span><span class="last">✓ ${t('कोई जमा राशि या नकद पुरस्कार नहीं','No deposits. No cash prizes.')}</span></div><section><div class="section-heading"><div><h2>${t('अपना अगला मैच चुनें','Find your next game')}</h2><p>${t('काल्पनिक मैच और खिलाड़ी · अभ्यास के लिए','Fictional fixtures and players · For practice')}</p></div><div class="filters" role="group" aria-label="Sports">${['cricket','football','kabaddi'].map((s,i)=>`<button class="filter ${state.sport===s?'active':''}" aria-pressed="${state.sport===s}" data-sport="${s}">${['◉','⚽','⚑'][i]} ${s[0].toUpperCase()+s.slice(1)}</button>`).join('')}</div></div><div class="matches">${fixtures[state.sport].map(matchHTML).join('')}</div></section><div class="bottom-grid"><section><div class="eyebrow">THREE STEPS. ONE GREAT GAME.</div><h2 style="margin-top:8px">${t('खेलना बिल्कुल आसान है।','Your instincts. Put to work.')}</h2>${steps()}</section><section class="leaderboard"><div class="eyebrow">COMMUNITY SPOTLIGHT</div><h2 style="margin-top:8px">${t('उदाहरण लीडरबोर्ड','Example leaderboard')}</h2>${[['RS','Riya S.','2,480'],['VK','Vikram K.','2,310'],['AM','Aarav M.','2,190']].map((x,i)=>`<div class="leader"><span class="rank">0${i+1}</span><span class="initial">${x[0]}</span>${x[1]}<strong>${x[2]} PTS</strong></div>`).join('')}</section></div>`;
}
if(page==='teams'){
html=title('मेरी टीमें','My teams')+(state.teams.length?`<p class="note">${t('डेमो स्कोर केवल एक बार बनाया जा सकता है। यह लाइव मैच का स्कोर नहीं है।','Each team can simulate a score once. This is not live match scoring.')}</p><div class="saved-list">${state.teams.map((team,i)=>`<article class="saved-team"><div class="eyebrow">${esc(team.sport)} · ${team.score==null?'PRACTICE READY':'DEMO COMPLETED'}</div><h3>${esc(team.match)}</h3><p>${team.players.map(p=>esc(p.name)+(p.id===team.captain?' (C)':p.id===team.vice?' (VC)':'')).join(' · ')}</p><div class="detail-row"><span>${t('डेमो स्कोर','Demo score')}</span><strong>${team.score==null?'—':esc(team.score)+' PTS'}</strong></div><div class="saved-actions" style="margin-top:15px"><button class="outline" data-sim="${i}" ${team.score!=null?'disabled':''}>${t('स्कोर सिम्युलेट करें','Simulate score')}</button><button class="outline" data-delete="${i}">${t('हटाएँ','Delete')}</button></div></article>`).join('')}</div>`:`<div class="empty"><h2>${t('आपकी पहली टीम आपका इंतज़ार कर रही है।','Your first team is waiting.')}</h2><p>${t('मैच चुनें और अपने 5 पसंदीदा खिलाड़ियों की टीम बनाएँ।','Choose a fixture and select your five favourite players.')}</p><button class="primary" data-go="home">${t('मैच देखें','Explore matches')} ↗</button></div>`);
}
if(page==='points')html=title('मेरे वर्चुअल पॉइंट्स','My virtual points','PLAY FOR PRIDE')+`<div class="big-number">✦ 1,000</div><h2>${t('स्वागत पॉइंट्स','Welcome points')}</h2><p class="note">${t('इनकी कोई नकद कीमत नहीं है। इन्हें खरीदना, बेचना या निकालना संभव नहीं। अभ्यास कॉन्टेस्ट में ये खर्च नहीं होते। टीम का डेमो स्कोर इनसे अलग है।','These points have no monetary value and cannot be purchased, sold or withdrawn. Practice contests do not spend them. Team demo scores are separate.')}</p><div class="detail-row"><span>${t('स्वागत बोनस · डेमो','Welcome bonus · Demo')}</span><b>+1,000 PTS</b></div>`;
if(page==='rules')html=title('आपका खेल, आपके फैसले।','Your game. Your decisions.','THE PLAYBOOK')+steps()+`<div style="margin-top:30px">${[[t('टीम बनाने का नियम','Team rules'),t('5 खिलाड़ी चुनें, दोनों टीमों से कम से कम 1 खिलाड़ी लें। कुल बजट 50 क्रेडिट है। कप्तान और उपकप्तान अलग होने चाहिए।','Select 5 players, including at least one from each side, within 50 credits. Captain and vice-captain must be different.')],[t('डेमो स्कोर कैसे बनता है?','How are demo scores calculated?'),t('हर खिलाड़ी को सिम्युलेशन में 10–50 पॉइंट्स मिलते हैं। कप्तान को 2×, उपकप्तान को 1.5×। यह यादृच्छिक अभ्यास स्कोर है, वास्तविक प्रदर्शन नहीं।','Simulation assigns each player 10–50 points. Captain: 2×; vice-captain: 1.5×. Random practice data, not actual performance.')],[t('क्या यह APK है?','Is this an APK?'),t('नहीं। यह काम करने वाला स्थानीय वेब डेमो है। Signed Android APK, iOS build, सुरक्षित backend, OTP और लाइव स्कोर इसमें शामिल नहीं हैं।','No. This is a working local web demo. Signed Android APK, iOS build, secured backend, OTP and live scores are not included.')],[t('ब्रांड और सुरक्षा','Brand and safety'),t('Akku Play स्वतंत्र डेमो है और Dream11 से संबद्ध नहीं है। असली पहचान, बैंक विवरण या भुगतान जानकारी दर्ज न करें।','Akku Play is an independent demo, not affiliated with Dream11. Do not enter real identity, bank or payment details.')]].map(x=>`<section style="padding:22px 0;border-bottom:1px solid var(--line)"><h2>${x[0]}</h2><p class="note">${x[1]}</p></section>`).join('')}</div>`;
if(page==='admin')html=title('लोकल डेमो कंट्रोल','Local demo controls','PREVIEW / NOT SECURED ADMIN')+`<p class="note">${t('यह सुरक्षित production admin नहीं है। यहाँ केवल आपके ब्राउज़र का डेटा दिखता है; वास्तविक users या payments नहीं।','Not a secured production admin. Only this browser’s data is shown; no real users or payments.')}</p>${[[t('डेमो मैच','Demo fixtures'),6],[t('लोकल टीमें','Local teams'),state.teams.length],[t('सिम्युलेटेड टीमें','Simulated teams'),state.teams.filter(x=>x.score!=null).length],[t('भुगतान','Payments'),'DISABLED']].map(x=>`<div class="detail-row"><span>${x[0]}</span><b>${x[1]}</b></div>`).join('')}<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px"><button class="outline" id="export">${t('डेमो डेटा डाउनलोड करें','Export demo data')}</button><button class="outline" id="reset">${t('सभी लोकल टीमें हटाएँ','Clear local teams')}</button></div>`;
if(page==='profile')html=title('आपकी खिलाड़ी प्रोफ़ाइल','Your player profile','LOCAL PROFILE')+`<form class="settings" id="profileForm"><p class="note">${t('यह केवल स्थानीय नाम है, सुरक्षित लॉगिन नहीं।','A local display name only, not a secure login.')}</p><label class="field">${t('डिस्प्ले नाम','Display name')}<input id="name" required maxlength="30" value="${esc(state.name)}" autocomplete="nickname"></label><button class="primary" type="submit">${t('नाम सेव करें','Save name')}</button></form>`;
$('#content').innerHTML=`<div class="view">${html}</div>`;applyLanguage();
if($('#profileForm'))$('#profileForm').onsubmit=e=>{e.preventDefault();const n=$('#name').value.trim();if(!n)return;state.name=n;save();applyLanguage();notify(t('नाम सेव हो गया।','Name saved.'))};
}
function openModal(title){$('#modalTitle').textContent=title;$('#modalContent').replaceChildren();if(!$('#modal').open)$('#modal').showModal()}
function build(index){const m=fixtures[state.sport][index];draft={sport:state.sport,match:`${m.a} vs ${m.b}`,fixture:m,selected:[],captain:null,vice:null,players:names.map((name,id)=>({id,name,side:id<5?m.ac:m.bc,role:roles[state.sport][id],credit:[10,9,8,11,9,10,8,11,9,10][id]}))};playerStep()}
function progress(step){return `<div class="progress" aria-hidden="true"><span class="on"></span><span class="${step>=2?'on':''}"></span><span class="${step>=3?'on':''}"></span></div>`}
function playerStep(){
openModal(t('अपनी टीम चुनें','Choose your team'));
$('#modalContent').innerHTML=progress(1)+`<p class="note">${esc(draft.match)}<br>${t('5 खिलाड़ी · दोनों टीमों से चयन · 50 क्रेडिट बजट','5 players · Both sides represented · 50 credit budget')}</p><div id="players">${draft.players.map(p=>`<label class="player"><input type="checkbox" value="${p.id}" ${draft.selected.includes(p.id)?'checked':''}><span class="player-avatar">${p.name[0]}</span><span>${p.name}<small>${p.side} · ${p.role}</small></span><span class="credit">${p.credit} CR</span></label>`).join('')}</div><div class="dialog-actions"><span id="selectionCount" aria-live="polite"></span><button class="primary" id="next">${t('कप्तान चुनें','Choose captain')} →</button></div>`;
function update(){draft.selected=[...$('#players').querySelectorAll('input:checked')].map(x=>Number(x.value));const picked=draft.players.filter(p=>draft.selected.includes(p.id)),credits=picked.reduce((s,p)=>s+p.credit,0),both=new Set(picked.map(p=>p.side)).size===2;$('#selectionCount').textContent=`${picked.length}/5 · ${credits}/50 CR`;$('#next').disabled=picked.length!==5||credits>50||!both;$('#players').querySelectorAll('input').forEach(x=>x.disabled=!x.checked&&picked.length>=5)}
$('#players').onchange=update;update();$('#next').onclick=captainStep;
}
function captainStep(){
openModal(t('अपने लीडर चुनें','Choose your leaders'));const selected=draft.players.filter(p=>draft.selected.includes(p.id));
$('#modalContent').innerHTML=progress(2)+`<p class="note">${t('कप्तान: 2× पॉइंट्स · उपकप्तान: 1.5× पॉइंट्स','Captain: 2× points · Vice-captain: 1.5× points')}</p>${selected.map(p=>`<div class="player"><span class="player-avatar">${p.name[0]}</span><span>${p.name}<small>${p.side} · ${p.role}</small></span><div class="select-captain"><button class="captain-button ${draft.captain===p.id?'selected':''}" data-captain="${p.id}" aria-label="Captain ${p.name}" aria-pressed="${draft.captain===p.id}">C</button><button class="captain-button ${draft.vice===p.id?'selected':''}" data-vice="${p.id}" aria-label="Vice-captain ${p.name}" aria-pressed="${draft.vice===p.id}">VC</button></div></div>`).join('')}<div class="dialog-actions"><button class="outline" id="back">${t('← वापस','← Back')}</button><button class="primary" id="join" ${draft.captain==null||draft.vice==null?'disabled':''}>${t('मुफ़्त जुड़ें','Join for free')} ↗</button></div>`;
$('#back').onclick=playerStep;$('#join').onclick=joinTeam;
$('#modalContent').onclick=e=>{const c=e.target.closest('[data-captain]'),v=e.target.closest('[data-vice]');if(c){draft.captain=Number(c.dataset.captain);if(draft.vice===draft.captain)draft.vice=null;captainStep()}if(v){draft.vice=Number(v.dataset.vice);if(draft.captain===draft.vice)draft.captain=null;captainStep()}};
}
function joinTeam(){if(draft.captain==null||draft.vice==null||draft.captain===draft.vice)return;state.teams.push({id:Date.now(),sport:draft.sport,match:draft.match,players:draft.players.filter(p=>draft.selected.includes(p.id)),captain:draft.captain,vice:draft.vice,score:null});save();$('#modalContent').onclick=null;openModal(t('टीम तैयार है!','You’re in!'));$('#modalContent').innerHTML=progress(3)+`<div class="success"><div class="success-symbol">✓</div><h2>${t('आपका खेल शुरू।','Let the game begin.')}</h2><p class="note">${esc(draft.match)}<br>${t('टीम इस डिवाइस पर सेव हो गई। कोई शुल्क नहीं कटा।','Team saved on this device. No entry fee charged.')}</p><button class="primary" id="seeTeams">${t('मेरी टीमें देखें','View my teams')} →</button></div>`;$('#seeTeams').onclick=()=>{$('#modal').close();go('teams')};render()}
$('#content').onclick=e=>{
const buildButton=e.target.closest('[data-build]'),sportButton=e.target.closest('[data-sport]'),navButton=e.target.closest('[data-go]'),sim=e.target.closest('[data-sim]'),del=e.target.closest('[data-delete]');
if(buildButton){$('#modalContent').onclick=null;build(Number(buildButton.dataset.build))}
if(sportButton){state.sport=sportButton.dataset.sport;render()}
if(navButton)go(navButton.dataset.go);
if(sim){const team=state.teams[Number(sim.dataset.sim)];if(team&&team.score==null){team.score=team.players.reduce((sum,p)=>sum+(10+Math.floor(Math.random()*41))*(p.id===team.captain?2:p.id===team.vice?1.5:1),0);save();render();notify(t('डेमो स्कोर तैयार है। यह लाइव स्कोर नहीं है।','Demo score ready. This is not a live score.'))}}
if(del&&confirm(t('यह टीम हटाएँ?','Delete this team?'))){state.teams.splice(Number(del.dataset.delete),1);save();render();notify(t('टीम हटा दी गई।','Team deleted.'))}
if(e.target.closest('#reset')&&confirm(t('इस डिवाइस की सभी टीमें हटाएँ?','Clear every team on this device?'))){state.teams=[];save();render();notify(t('लोकल टीमें हटाई गईं।','Local teams cleared.'))}
if(e.target.closest('#export')){const blob=new Blob([JSON.stringify({app:'Akku Play',type:'local-demo',name:state.name,teams:state.teams},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='akku-play-demo.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
};
document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>go(b.dataset.page));
document.querySelectorAll('.brand').forEach(a=>a.onclick=e=>{e.preventDefault();go('home')});
$('#profile').onclick=()=>go('profile');
$('#language').onclick=()=>{state.lang=state.lang==='hi'?'en':'hi';save();$('#modal').close();render()};
$('#close').onclick=()=>$('#modal').close();
$('#modal').addEventListener('close',()=>{$('#modalContent').onclick=null});
$('#modal').addEventListener('click',e=>{if(e.target!==$('#modal'))return;const r=$('#modal').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)$('#modal').close()});
render();
</script>
</body>
</html>